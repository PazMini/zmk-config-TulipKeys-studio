

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                           |  6   |  7    |  8    |  9   |   0   |  BKSP |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                           |  Y   |  U    |  I    |  O   |   P   |   \   |
// |  CAPS |  A  |  S  |  D   |  F   |  G   |                           |  G   |  H    |  J    |  K   |   L   |  ENT  |   
// | SHIFT |  "  |  Z  |  X   |  C   |  V   |                           |  V   |  B    |  N    |  M   |   ;   | SHIFT |
// | CTRL  | ALT | LYR |  ,   |  .   | SPC  |                           | SPC  | LARW  |  UARW | RARW | DARW  | LYR  |

            display-name = "Base";
            bindings = <
&kp ESC   &kp N1    &kp N2    &kp N3     &kp N4     &kp N5              &kp N6     &kp N7   &kp N8     &kp N9    &kp N0     &kp BSPC
&kp TAB   &kp Q     &kp W     &kp E      &kp R      &kp T               &kp Y      &kp U    &kp I      &kp O     &kp P      &kp BSLH
&kp CAPS  &kp A     &kp S     &kp D      &kp F      &kp G               &kp G      &kp H    &kp J      &kp K     &kp L      &kp ENTER
&kp LSHFT &kp QUOTE &kp Z     &kp X      &kp C      &kp V               &kp V      &kp B    &kp N      &kp M     &kp SEMI    &kp RSHFT
&kp LCTRL &kp LALT  &mo 1     &kp COMMA  &kp DOT    &kp SPACE           &kp SPACE  &kp LEFT &kp UP     &kp RIGHT &kp DOWN   &mo 2
            >; 

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
// ------------------------------------------------------------------------------------------------------------
// | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   | prv  | USB   |. BLE. |  -   |   =   | BTCLR |
// |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
// |   `   |  !  |  @  |  #   |   $  |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
// | LSHFT |     |     |      |      |      |                   |  -   |   +   | UARW  |  {   |   }   |  "|"  |
// | CTRL  | ALT |(LYR)|  GUI |      |      |                   |      | LARW  | DARW  | RARW |       |  RGUI |       
            display-name = "Lower";
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                 &bt BT_PRV   &out OUT_USB   &out OUT_BLE    &kp MINUS  &kp PLUS  &bt BT_CLR
&kp F1     &kp F2       &kp F3       &kp F4       &kp F5       &kp F6                       &kp F7       &kp F8       &kp F9          &kp F10    &kp F11   &kp F12
&kp GRAVE  &kp EXCL     &kp AT       &kp HASH     &kp DOLLAR     &kp PRCNT                    &kp CARET    &kp AMPS     &kp KP_MULTIPLY &kp LPAR   &kp RPAR  &kp TILDE
&kp LSHFT  &trans       &trans       &trans       &trans       &trans                       &kp MINUS    &kp KP_PLUS  &kp UP          &kp LBRC   &kp RBRC  &kp PIPE
&kp LCTRL  &kp LALT     &trans       &kp LGUI     &trans       &trans                       &trans       &kp LEFT     &kp DOWN        &kp RIGHT  &trans    &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |     |  %  |  (   |   )  |   /  |                   |      |   _   |   =    |  -   |   +  |  BKSP  |
// |       |     |  7  |  8   |  9   |   *  |                   |      |   {   |   }    |  [   |   ]  |  '|'   |
// |       |     |  4  |  5   |  6   |   -  |                   |      |       |   "    |  ;   |  '   |  ENT   |
// |       |     |  1  |  2   |  3   |   +  |                   |      |       |   <    |  >   |   ?  |  RSHFT |
// |       |     |     |  0   |  .   |   =  |                   |      |       |        |      |      |        |
                display-name = "Raise";
            bindings = <
&trans  &trans &kp PRCNT &kp LPAR   &kp RPAR   &kp KP_DIVIDE             &trans      &kp UNDERSCORE   &kp EQUAL   &kp MINUS   &kp PLUS    &kp BKSP
&trans  &trans &kp N7    &kp N8     &kp N9     &kp KP_MULTIPLY           &trans      &kp LBRC    &kp RBRC    &kp LBKT    &kp RBKT    &kp PIPE
&trans  &trans &kp N4    &kp N5     &kp N6     &kp KP_MINUS              &trans      &trans      &kp DOUBLE_QUOTES     &kp SEMI    &kp QUOTE   &kp ENT
&trans  &trans &kp N1    &kp N2     &kp N3     &kp KP_PLUS               &trans      &trans      &kp LESS_THAN      &kp GREATER_THAN      &kp QMARK   &kp RSHFT
&trans  &trans &trans    &kp N0     &kp KP_DOT &kp KP_ENTER              &trans      &trans       &trans    &trans       &trans      &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
